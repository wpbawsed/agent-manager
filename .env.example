# Agent Manager — 環境變數範本
# 複製為 .env 並填入實際值

# API Server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# JWT Secret（隨機字串，例如：openssl rand -hex 32）
JWT_SECRET=change-me-please-use-openssl-rand-hex-32

# PostgreSQL 連線字串
# 本機開發：postgresql://agent:agent@localhost:5432/agent_manager
# Docker Compose 內：postgresql://agent:agent@postgres:5432/agent_manager
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_manager

# Redis 連線字串
# 本機開發：redis://localhost:6379
# 有密碼：redis://:password@host:6379
REDIS_URL=redis://localhost:6379

# /internal/events 的共用 token（agent 回報 Event 開始／結束用，隨機字串）
INTERNAL_TOKEN=change-me-please-use-openssl-rand-hex-32

# 對外網址：產生給 agent 的設定資料（AGENT_MANAGER_URL）會用它
MANAGER_PUBLIC_URL=http://localhost:8080

# UI 的對外網址：工作流「等待審查」通知裡的連結會指到這裡
UI_PUBLIC_URL=http://localhost:3000

# UI（Vite dev server proxy target）
CORS_ORIGIN=http://localhost:3000
