{
  "name": "agent-manager",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @agent-manager/api --filter @agent-manager/ui run dev",
    "dev:api": "pnpm --filter @agent-manager/api run dev",
    "dev:ui": "pnpm --filter @agent-manager/ui run dev",
    "docker:dev": "docker compose up --build",
    "deploy:workers": "pnpm --filter @agent-manager/worker-slack run deploy && pnpm --filter @agent-manager/worker-jira run deploy",
    "tf:init": "terraform -chdir=infra/terraform init",
    "tf:plan": "terraform -chdir=infra/terraform plan",
    "tf:apply": "terraform -chdir=infra/terraform apply"
  }
}
